        "jsCode": "// Obter o item de entrada\nconst items = $input.all();\nconst results = [];\n\n// Loop pelos itens de entrada\nfor (const item of items) {\n  const text = item.json.output;\n\n  // Dividir por quebras de linha duplas (separação de parágrafos)\n  const parts = text.split(/\\n\\n/);\n\n  // Processar cada parte\n  parts.forEach((part) => {\n    if (part.trim() !== '') {\n      results.push({ json: { part: part.trim() } });\n    }\n  });\n}\n\n// Retornar como múltiplos itens\nreturn results;\n"
      },
